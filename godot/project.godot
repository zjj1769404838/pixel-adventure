; Godot 4 工程配置 —— 横版像素平台跳跃《像素冒险》
; 尺寸取自 game.json: canvas [640, 360], tile 16

config_version=5

[application]

config/name="像素冒险"
config/description="横版像素平台跳跃：跑、跳、踩敌人、顶砖块、收集金币、抵达终点旗。"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon_192.png"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
; 0 = Landscape, 1 = Portrait (Godot 4.7 此键是 int 枚举，写字符串会被静默忽略并回落为 0)
window/handheld/orientation=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=1300.0
