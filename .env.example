# 《像素冒险》OTA 邮件通知配置样例
#
# 用法：
#   1) 复制成 .env（同目录），填入真实值：
#        copy .env.example .env          （Windows cmd）
#        cp .env.example .env            （bash / PowerShell 也行）
#   2) .env 已在 .gitignore 里，不会被提交。
#   3) 本项目脚本**不自动读取 .env**（只用 Python 标准库、不引入 dotenv），
#      所以需要在 shell 里把变量导进环境，再跑 send_release_email.py。
#
#       PowerShell:
#        Get-Content .env | Where-Object { $_ -match '^OTA_' } | ForEach-Object {
#            $k,$v = $_ -split '=',2; [Environment]::SetEnvironmentVariable($k,$v,'Process')
#        }
#        D:/apps/Python313/python.exe scripts/send_release_email.py --manifest dist/latest.json
#
#       bash:
#        set -a; . ./.env; set +a
#        D:/apps/Python313/python.exe scripts/send_release_email.py --manifest dist/latest.json
#
# 安全提醒：
#   * 这里**不含任何真实凭据**，也永远不要把真实密码提交进仓库。
#   * 建议用「应用专用密码」而不是邮箱主密码（QQ 邮箱 / 163 / Gmail 都支持）。
#   * 一旦怀疑泄露，立刻去邮箱后台吊销该应用密码，不要只改文件。

# --- 必填 ---
# SMTP 服务器地址
OTA_SMTP_HOST=your-host.example.com

# 收件人，多个用英文逗号分隔
OTA_SMTP_TO=your-recipient@example.com

# --- 连接 ---
# 端口：587 = STARTTLS（推荐），465 = SSL，25 = 明文（仅内网测试）
OTA_SMTP_PORT=587

# 安全方式：starttls（默认）/ ssl / none
OTA_SMTP_SECURITY=starttls

# --- 认证 ---
# 留空则跳过登录（便于本地测试本地 SMTP 中继）
OTA_SMTP_USER=your-user
OTA_SMTP_PASS=CHANGE_ME

# 发件人；留空则自动用 OTA_SMTP_USER
OTA_SMTP_FROM=your-user

# --- 附件 ---
# 附件大小上限（MB）。超过则不发附件，正文只放下载链接。
# 注意：多数邮箱服务商的单封邮件上限是 20-25MB，APK 目前约 29MB，
# 所以默认值下会走「只发链接」分支——这是预期行为。
OTA_MAIL_MAX_ATTACHMENT_MB=20
